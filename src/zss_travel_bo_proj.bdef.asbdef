projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZSS_TRAVEL_BO_PROJ alias Travel
{
  use create;
  use update;
  use delete;


  //expose our draft actions--
  use action Edit;
  use action Prepare;
  use action Discard;
  use action Activate;
  use action Resume;
  use action copyTravel;

  use association _Booking { create; with draft;}
}

define behavior for ZSS_BOOKING_BO_PROJ alias Booking
{
  use update;
  use delete;

  use association _Travel {with draft;}
  use association _BookSuppl { create; with draft;}
}

define behavior for ZSS_BOOKINGSUPP_BO_PROJ alias BookSuppl
{
  use update;
  use delete;

  use association _Travel {with draft;}
  use association _Booking {with draft;}
}